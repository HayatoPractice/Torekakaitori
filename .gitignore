.Trashes

# AIエージェントの内部設定（リポジトリに含めない）
# ※ディレクトリ全体ではなくワイルドカードで除外（例外指定を有効にするため）
.claude/*
# settings.json と commands/ はバージョン管理対象（全アプリへ同期するため）
!.claude/settings.json
!.claude/commands
!.claude/commands/**

# 環境変数・秘密鍵
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
client_secret*.json

# 依存関係
node_modules/
.venv/
venv/
env/

# ビルド成果物
dist/
build/
out/
*.pyc
__pycache__/

# TypeScript増分ビルドキャッシュ
*.tsbuildinfo

