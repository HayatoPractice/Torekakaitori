# このファイルを .env.local にコピーして値を埋めてください（.env.local はgit管理対象外）

# Neon（Postgres）。プロジェクト作成後の接続文字列（Connection string）をそのまま貼る
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Google Gemini API（無料枠。https://aistudio.google.com/apikey から取得）
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 省略可。既定値: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# 簡易Basic認証（本番で必須。未設定だと誰でもアクセスできてしまう）
BASIC_AUTH_PASSWORD=xxxxxxxxxxxx
# 省略可。既定値: torecasouba
BASIC_AUTH_USER=torecasouba
